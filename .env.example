# 复制为 .env（已在 .gitignore 中，不会提交），或直接在页面「⚙ 设置」里填写

# 栏目名：印在文章眉题和小红书卡片页脚
JZS_BRAND=一稿

# ── 写作 API：任意 OpenAI 兼容接口 ──
#   DeepSeek  https://api.deepseek.com/v1                         deepseek-chat
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Kimi      https://api.moonshot.cn/v1                          moonshot-v1-32k
JZS_LLM_BASE_URL=
JZS_LLM_API_KEY=
JZS_LLM_MODEL=

# ── 生图 API：OpenAI 兼容 /images/generations ──
#   OpenAI       https://api.openai.com/v1                       gpt-image-1
#   豆包 Seedream https://ark.cn-beijing.volces.com/api/v3        doubao-seedream-3-0-t2i-250415
#   SiliconFlow  https://api.siliconflow.cn/v1                   Kwai-Kolors/Kolors
JZS_IMAGE_BASE_URL=
JZS_IMAGE_API_KEY=
JZS_IMAGE_MODEL=
JZS_IMAGE_SIZE=1536x1024

# ── Codex 自动执行（需先 npm i -g @openai/codex && codex login）──
# 默认找 PATH 里的 codex；没全局安装可填：npx -y @openai/codex
JZS_CODEX_CMD=
JZS_CODEX_MODEL=
JZS_CODEX_TIMEOUT=600

# 图库搜图，免费申请：https://www.pexels.com/api/
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# 草稿目录（默认 ./workspace）
JZS_WORKSPACE=
