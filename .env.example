# 复制为 .env（已在 .gitignore 中，不会提交），工作台启动时自动读取

# ── 内置写作（填了就能一键生成全文；不填也能用「复制简报给外部 AI」）──
# 任意 OpenAI 兼容接口，例如：
#   DeepSeek  https://api.deepseek.com/v1                         deepseek-chat
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Kimi      https://api.moonshot.cn/v1                          moonshot-v1-32k
JZS_LLM_BASE_URL=
JZS_LLM_API_KEY=
JZS_LLM_MODEL=

# 氛围配图素材源，免费申请：https://www.pexels.com/api/
PEXELS_API_KEY=
# 备用素材源（可选）
UNSPLASH_ACCESS_KEY=
# 项目草稿存放目录（可选，默认 ./workspace）
JZS_WORKSPACE=
